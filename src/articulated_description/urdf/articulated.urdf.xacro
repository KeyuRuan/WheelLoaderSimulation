        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://articulated_description/meshes/bucket_arm_nocylinder_wide.dae" />
      </geometry>
    </collision>
  </link>
  <joint
    name="bucket_arm_axis"
    type="revolute">
    <origin
      xyz="-0.64 0 1.87"
      rpy="0 0 0" />
    <parent
      link="frontbase_link" />
    <child
      link="bucket_arm_Link" />
    <axis
      xyz="0 -1 0" />
    <limit
      lower="-0.25"
      upper="1.0"
      effort="200000"
      velocity="0.5" />
    <dynamics damping="40.0" friction="3.0" />
  </joint>
  <joint
    name="arm_to_rocker"
    type="fixed">
    <origin
      xyz="0.95719 0 -0.082758"
      rpy="0 -0.7 0" />
    <parent
      link="bucket_arm_Link" />
    <child
      link="rocker_holder_link" />
  </joint>
  <link
    name="rocker_holder_link">
    <inertial>
      <origin
