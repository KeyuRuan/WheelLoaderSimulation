      <geometry>
        <mesh
          filename="package://articulated_description/meshes/rocker_holder.dae" />
      </geometry>
    </collision>
  </link>
  <link
    name="rocker_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="10.0" />
      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
