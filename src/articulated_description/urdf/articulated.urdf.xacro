<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="vehicle_urdf_model">
  <xacro:property name="hydraulic_tube_depth" value="0.5249" />
  <xacro:property name="hydraulic_cylinder_start_offset" value="0.05843" />

  <!-- Lift-arm rear mount reference:
       CAD mesh shaft center = (-0.28, 1.41, 0.0)
       URDF joint origin     = (-0.28, 0.0, 1.41). -->
  <link
    name="frontbase_link">
    <inertial>
      <origin
        xyz="-0.15633 2.387E-07 1.0079"
        rpy="0 0 0" />
      <mass
        value="5327.1" />
      <inertia
        ixx="1543.9"
        ixy="0.0014228"
        ixz="222.2"
        iyy="2510.6"
        iyz="-0.0019455"
        izz="2276.8" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://articulated_description/meshes/frontbase_Link_with_cylinder.dae" />
      </geometry>
      <material
        name="yellow_body">
        <color
          rgba="0.8 0.6 0.0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://articulated_description/meshes/frontbase_Link_with_cylinder.dae" />
      </geometry>
    </collision>
  </link>
  <link
    name="leftfrontwheel_Link">
    <inertial>
      <origin
        xyz="-1.1102E-16 -0.17395 -1.1102E-16"
        rpy="0 0 0" />
      <mass
        value="492.2" />
      <inertia
        ixx="84.12"
        ixy="1.0524E-16"
        ixz="-1.4211E-14"
        iyy="158.30"
        iyz="-4.5117E-17"
        izz="84.12" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://articulated_description/meshes/leftfrontwheel_Link.dae" />
      </geometry>
      <material
        name="black_wheel">
        <color
          rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.175 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.75" length="0.35" />
      </geometry>
    </collision>
  </link>
  <joint
    name="leftfrontwheel_to_frontbase"
    type="continuous">
    <origin
      xyz="-0.5 0.821 0.75"
      rpy="3.1416 0.91009 -7.8779E-17" />
    <parent
      link="frontbase_link" />
    <child
      link="leftfrontwheel_Link" />
    <axis
      xyz="0 -1 0" />
    <limit
      effort="10000"
      velocity="10.0" />
    <dynamics damping="1.0" friction="0.2" />
  </joint>
  <link
    name="rightfrontwheel_Link">
    <inertial>
      <origin
        xyz="1.1102E-16 -0.17395 -1.1102E-16"
        rpy="0 0 0" />
      <mass
        value="492.2" />
      <inertia
        ixx="84.12"
        ixy="8.8544E-17"
        ixz="-3.0304E-49"
        iyy="158.30"
        iyz="-1.3628E-17"
        izz="84.12" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://articulated_description/meshes/rightfrontwheel_Link.dae" />
      </geometry>
      <material
        name="black_wheel">
        <color
          rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.175 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.75" length="0.35" />
      </geometry>
    </collision>
  </link>
  <joint
    name="rightfrontwheel_to_frontbase"
    type="continuous">
    <origin
      xyz="-0.5 -0.821 0.75"
      rpy="-3.1416 -0.72502 3.1416" />
    <parent
      link="frontbase_link" />
    <child
      link="rightfrontwheel_Link" />
    <axis
      xyz="0 1 0" />
    <limit
      effort="10000"
      velocity="10.0" />
    <dynamics damping="1.0" friction="0.2" />
  </joint>
  <link
    name="bucket_arm_Link">
    <inertial>
      <origin
        xyz="0.7 0 0"
        rpy="0 0 0" />
      <mass
        value="10.0" />
      <inertia
        ixx="1.5"
        ixy="0.0"
        ixz="0.0"
        iyy="7.5"
        iyz="0.0"
        izz="7.5" />
