<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="dumpster">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <scale>2.25 2.25 1.2</scale>
            <uri>meshes/dumpster.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <scale>2.25 2.25 1.2</scale>
            <uri>meshes/dumpster.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://dumpster/materials/textures/Dumpster_Diffuse.png</albedo_map>
              <metalness_map>model://dumpster/materials/textures/Dumpster_Spec.png</metalness_map>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
