    <!-- ============================================================ -->
    <!-- Wall ribs for lidar anti-degeneracy                          -->
    <!-- Protrude into interior and extend to the full outer-wall height -->
    <!-- South wall (Y=-35, inside face Y=-34.75): ribs at Y=-34.65  -->
    <!-- ============================================================ -->
    <link name="rib_south_0">
      <pose>-30 -34.65 6 0 0 0</pose>
      <collision name="collision"><geometry><box><size>0.5 0.2 12</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.5 0.2 12</size></box></geometry>
        <material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material>
      </visual>
    </link>
