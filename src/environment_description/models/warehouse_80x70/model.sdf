    <link name="rib_dw2l_r0"><pose>0.25 -30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2l_l1"><pose>-0.25 -20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2l_r1"><pose>0.25 -20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>

    <!-- div_wall_3_left (X=-20, Y=-35~-15): ribs at Y=-30,-20 -->
    <link name="rib_dw3l_l0"><pose>-20.25 -30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw3l_r0"><pose>-19.75 -30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw3l_l1"><pose>-20.25 -20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
