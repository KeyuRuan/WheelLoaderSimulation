<?xml version="1.0"?>
<!--
  Warehouse: 80m (X) x 70m (Y), L-shaped north-west corner
  Notch removed: X from -40 to -20, Y from +5 to +35
  Outer wall height: 12m, dividing wall height: 3m
-->
<sdf version="1.7">
  <model name="warehouse_80x70">
    <static>true</static>

    <!-- Floor -->
    <link name="floor">
      <pose>0 0 0.05 0 0 0</pose>
      <collision name="floor_collision">
        <geometry>
          <box><size>80 70 0.1</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="floor_visual">
        <geometry>
          <box><size>80 70 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- North main wall: X=-20 to X=+40 at Y=+35, length=60m, center X=+10 -->
    <link name="wall_north">
      <pose>10 35 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>60 0.5 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>60 0.5 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- North step wall: at X=-20, Y=+5 to Y=+35, length=30m (outer wall replacing div_wall_3_right) -->
    <link name="wall_north_step">
      <pose>-20 20 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 30 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 30 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- North-west wall: X=-40 to X=-20 at Y=+5, length=20m, center X=-30 -->
    <link name="wall_north_west">
      <pose>-30 5 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>20 0.5 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>20 0.5 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- South wall: X=-40 to X=+40 at Y=-35, length=80m -->
    <link name="wall_south">
      <pose>0 -35 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>80 0.5 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>80 0.5 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- East wall: X=+40, Y=-35 to Y=+35, length=70m -->
    <link name="wall_east">
      <pose>40 0 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 70 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 70 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- West wall: X=-40, Y=-35 to Y=+5, length=40m (shortened due to L-shape) -->
    <link name="wall_west">
      <pose>-40 -15 6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 40 12</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 40 12</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- Internal dividing walls -->

    <!-- X=+20: both sides -->
    <link name="div_wall_1_right">
      <pose>20 20 1.5 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 30 3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 30 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <link name="div_wall_1_left">
      <pose>20 -25 1.5 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 20 3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 20 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- X=0: both sides -->
    <link name="div_wall_2_right">
      <pose>0 20 1.5 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 30 3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 30 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <link name="div_wall_2_left">
      <pose>0 -25 1.5 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 20 3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 20 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>

    <!-- X=-20: only left side (right side replaced by outer wall_north_step) -->
    <link name="div_wall_3_left">
      <pose>-20 -25 1.5 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.5 20 3</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.5 20 3</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Dividing wall ribs (3m walls), 0.1m protrusion on both sides, every 10m -->
    <!-- Rib size: 0.2(X) x 0.5(Y) x 2.5(Z), Z center=1.25                      -->
    <!-- ============================================================ -->

    <!-- div_wall_1_right (X=20, Y=5~35): ribs at Y=10,20,30 -->
    <link name="rib_dw1r_l0"><pose>19.75 10 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1r_r0"><pose>20.25 10 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1r_l1"><pose>19.75 20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1r_r1"><pose>20.25 20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1r_l2"><pose>19.75 30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1r_r2"><pose>20.25 30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>

    <!-- div_wall_1_left (X=20, Y=-35~-15): ribs at Y=-30,-20 -->
    <link name="rib_dw1l_l0"><pose>19.75 -30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1l_r0"><pose>20.25 -30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1l_l1"><pose>19.75 -20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw1l_r1"><pose>20.25 -20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>

    <!-- div_wall_2_right (X=0, Y=5~35): ribs at Y=10,20,30 -->
    <link name="rib_dw2r_l0"><pose>-0.25 10 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2r_r0"><pose>0.25 10 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2r_l1"><pose>-0.25 20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2r_r1"><pose>0.25 20 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2r_l2"><pose>-0.25 30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>
    <link name="rib_dw2r_r2"><pose>0.25 30 1.25 0 0 0</pose><collision name="c"><geometry><box><size>0.2 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 0.5 2.5</size></box></geometry><material><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>model://warehouse_80x70/meshes/wall_diffuse.jpg</albedo_map></metal></pbr></material></visual></link>

    <!-- div_wall_2_left (X=0, Y=-35~-15): ribs at Y=-30,-20 -->
